  m_TableData:
  - m_Id: 15779438592
    m_Localized: "Hey there, traveler! Haven\u2019t seen you around before."
    m_Metadata:
      m_Items: []
  - m_Id: 193739563008
    m_Localized: This village may look quiet, but strange things happen after sunset.
    m_Metadata:
      m_Items: []
  - m_Id: 219274485760
    m_Localized: If you plan to stay the night, make sure to keep your lantern close.
    m_Metadata:
      m_Items: []
  - m_Id: 243098132480
    m_Localized: "Oh, and one more thing... don\u2019t talk to anyone wearing a mask."
    m_Metadata:
      m_Items: []
