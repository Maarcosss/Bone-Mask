  m_TableData:
  - m_Id: 15779438592
    m_Localized: Hey, Reisender! Ich habe dich hier noch nie gesehen.
    m_Metadata:
      m_Items: []
  - m_Id: 193739563008
    m_Localized: Dieses Dorf sieht ruhig aus, aber nach Sonnenuntergang geschehen
      seltsame Dinge.
    m_Metadata:
      m_Items: []
  - m_Id: 219274485760
    m_Localized: "Wenn du vorhast, heute Nacht zu bleiben, halte deine Laterne in
      der N\xE4he."
    m_Metadata:
      m_Items: []
  - m_Id: 243098132480
    m_Localized: "Ach, und noch etwas... sprich mit niemandem, der eine Maske tr\xE4gt."
    m_Metadata:
      m_Items: []
