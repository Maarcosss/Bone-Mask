  m_TableData:
  - m_Id: 15779438592
    m_Localized: "Salut, voyageur ! Je ne t\u2019ai jamais vu par ici."
    m_Metadata:
      m_Items: []
  - m_Id: 193739563008
    m_Localized: "Ce village para\xEEt calme, mais des choses \xE9tranges se produisent
      apr\xE8s le coucher du soleil."
    m_Metadata:
      m_Items: []
  - m_Id: 219274485760
    m_Localized: "Si tu comptes passer la nuit, garde bien ta lanterne pr\xE8s de
      toi."
    m_Metadata:
      m_Items: []
  - m_Id: 243098132480
    m_Localized: "Oh, et encore une chose... ne parle \xE0 personne portant un masque."
    m_Metadata:
      m_Items: []
