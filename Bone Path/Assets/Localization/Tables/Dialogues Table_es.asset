  m_TableData:
  - m_Id: 15779438592
    m_Localized: "\xA1Hola, viajero! No te hab\xEDa visto antes por aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 193739563008
    m_Localized: "Este pueblo parece tranquilo, pero pasan cosas extra\xF1as despu\xE9s
      del atardecer."
    m_Metadata:
      m_Items: []
  - m_Id: 219274485760
    m_Localized: "Si planeas quedarte esta noche, aseg\xFArate de tener tu linterna
      a mano."
    m_Metadata:
      m_Items: []
  - m_Id: 243098132480
    m_Localized: "Ah, y una cosa m\xE1s... no hables con nadie que lleve una m\xE1scara."
    m_Metadata:
      m_Items: []
